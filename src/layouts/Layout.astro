---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { CONTACT_EMAIL, SITE_NAME } from "../lib/site.js";

const {
  title = "US Moving Cost Calculator — Relocation Cost",
  description = "Estimate what a US move could cost from distance, home size and move type, with a transparent method and sourced truck-rental benchmarks.",
  image = "/og-default.png",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Commit this page was built from, so the deployed version can be verified from the HTML itself.
// "unknown" marks a Vercel build that did not receive its commit SHA, so a missing
// identifier is visible in production instead of looking like a local build.
const buildCommit = (
  process.env.VERCEL_GIT_COMMIT_SHA ?? process.env.GITHUB_SHA ?? (process.env.VERCEL ? "unknown" : "local")
).slice(0, 40);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved theme choice before the page paints, so there is no flash.
      try {
        var saved = localStorage.getItem("relocation-theme");
        if (saved === "light" || saved === "dark") document.documentElement.setAttribute("data-theme", saved);
      } catch (e) {}
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="build-commit" content={buildCommit} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="google-site-verification" content="7FepTLNzBMDMUqNl8HCZd8pfZKlyG42NlPuZWULfia8" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/" class="text-lg font-bold tracking-tight text-slate-950">Relocation Cost</a>
        <nav class="flex gap-4 text-sm text-slate-600 sm:gap-6">
          <a href="/calculator/" class="hover:text-slate-950">Calculator</a>
          <a href="/moving-cost/" class="hidden hover:text-slate-950 sm:inline">Route costs</a>
          <a href="/guides/moving-cost/" class="hidden hover:text-slate-950 sm:inline">Moving costs</a>
          <a href="/guides/relocation-budget/" class="hidden hover:text-slate-950 sm:inline">Budget guide</a>
          <button id="themeToggle" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-2.5 py-1 text-slate-700 hover:border-slate-300 hover:text-slate-950 print:hidden" aria-label="Color theme: automatic. Press to change.">
            <svg id="themeIcon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path></svg>
            <span id="themeLabel">Auto</span>
          </button>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <script is:inline>
      // Theme choice: Auto follows the device, Light and Dark override it and are remembered.
      (function () {
        var button = document.getElementById("themeToggle");
        if (!button) return;
        var label = document.getElementById("themeLabel");
        var icon = document.getElementById("themeIcon");
        var order = ["auto", "light", "dark"];
        var names = { auto: "Auto", light: "Light", dark: "Dark" };
        var icons = {
          auto: '<circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>',
          light: '<circle cx="12" cy="12" r="4" fill="currentColor"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>',
          dark: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor"></path>'
        };
        function current() {
          var t = document.documentElement.getAttribute("data-theme");
          return t === "light" || t === "dark" ? t : "auto";
        }
        function show() {
          var mode = current();
          label.textContent = names[mode];
          icon.innerHTML = icons[mode];
          button.setAttribute("aria-label", "Color theme: " + names[mode].toLowerCase() + ". Press to change.");
        }
        button.addEventListener("click", function () {
          var next = order[(order.indexOf(current()) + 1) % order.length];
          if (next === "auto") document.documentElement.removeAttribute("data-theme");
          else document.documentElement.setAttribute("data-theme", next);
          try {
            if (next === "auto") localStorage.removeItem("relocation-theme");
            else localStorage.setItem("relocation-theme", next);
          } catch (e) {}
          show();
        });
        show();
      })();
    </script>
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-5 py-8 text-sm text-slate-500">
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
          <a href="/moving-cost/" class="hover:text-slate-950">Route costs</a>
          <a href="/moving-cost/cities/" class="hover:text-slate-950">City routes</a>
          <a href="/guides/moving-cost/" class="hover:text-slate-950">Moving costs</a>
          <a href="/guides/relocation-budget/" class="hover:text-slate-950">Budget guide</a>
          <a href="/guides/diy-vs-movers/" class="hover:text-slate-950">DIY vs movers</a>
          <a href="/checklist/" class="hover:text-slate-950">Checklist</a>
          <a href="/budget-tracker/" class="hover:text-slate-950">Budget tracker</a>
          <a href="/methodology/" class="hover:text-slate-950">Methodology</a>
          <a href="/disclosure/" class="hover:text-slate-950">Disclosure</a>
          <a href="/privacy/" class="hover:text-slate-950">Privacy</a>
          <a href="/about/" class="hover:text-slate-950">About</a>
          {CONTACT_EMAIL && <a href="/contact/" class="hover:text-slate-950">Contact</a>}
        </nav>
        <p class="mt-4">© {new Date().getFullYear()} Relocation Cost. Estimates are planning aids, not quotes.</p>
      </div>
    </footer>
  </body>
</html>
