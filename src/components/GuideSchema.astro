---
// Article + breadcrumb structured data and a visible breadcrumb for guide pages.
const { title, description, path } = Astro.props;
const url = new URL(path, Astro.site).href;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  mainEntityOfPage: url,
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: "Relocation Cost", url: new URL("/", Astro.site).href }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Guides", item: new URL("/guides/moving-cost/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: title, item: url }
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
<nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
  <a href="/" class="hover:text-slate-900">Home</a> <span aria-hidden="true">/</span>
  <a href="/guides/moving-cost/" class="hover:text-slate-900">Guides</a> <span aria-hidden="true">/</span>
  <span class="text-slate-700">{title}</span>
</nav>
