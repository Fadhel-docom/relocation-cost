---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found — Relocation Cost" description="This page does not exist. Return to the moving cost calculator." noindex={true}>
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-sky-600">404</p>
    <h1 class="mt-3 text-4xl font-bold">That page doesn't exist.</h1>
    <p class="mt-4 text-slate-600">Return to the calculator and continue planning your move.</p>
    <a href="/calculator" class="mt-8 inline-flex rounded-xl bg-slate-950 px-6 py-3 font-semibold text-white">Open calculator</a>
  </section>
</Layout>
