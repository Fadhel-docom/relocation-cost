---
import Layout from "../layouts/Layout.astro";
import cityData from "../../data/cities.json";
import cityRoutes from "../../data/city-routes.json";
import stateData from "../../data/state-distances.json";
import statePages from "../../data/route-pages.json";
import { HOME_HERO_VALUE, HOME_ANSWER_HEADING, HOME_ANSWER_LEAD, HOME_ANSWER_MOVE, HOME_ANSWER_AROUND, HOME_ANSWER_LIMITS, HOME_ANSWER_LINKS } from "../lib/home-answer.js";

const cities = cityData.cities;
const featuredCityRoutes = cityRoutes.routes.slice(0, 8);
const featuredStateRoutes = statePages.routes.slice(0, 8);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Relocation Cost",
  url: new URL("/", Astro.site).href,
  description: "US moving cost calculator and route planning guides."
};
---
<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
<Layout
  title="US Moving Cost Calculator & Employer Budget — Relocation Cost"
  description="Estimate US moving costs by distance, home size and move type, or compare costs with an employer relocation package. Transparent methods and sourced benchmarks."
>
  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
      <div class="max-w-3xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-sky-300">Relocation Cost Suite</p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">Build your full moving budget before you request quotes.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">Go beyond the mover’s price: add travel, temporary housing, deposits, setup, storage, employer support and a separate cash buffer.</p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-sky-100">{HOME_HERO_VALUE}</p>
        <form action="/calculator/" method="get" class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 text-slate-950 shadow-xl sm:p-6" aria-label="Start a moving budget">
          <p class="text-base font-bold">Start with your move</p>
          <p class="mt-1 text-sm leading-6 text-slate-600">{HOME_QUICK_START_LEAD}</p>
          <input type="hidden" name="distance" value="" />
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-semibold">Moving from
              <select name="fromState" required class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3 text-slate-950">
                <option value="" selected disabled>Choose a state</option>
                {Object.entries(stateData.states).sort(([, a], [, b]) => a.name.localeCompare(b.name)).map(([code, state]) => <option value={code}>{state.name}</option>)}
              </select>
            </label>
            <label class="block text-sm font-semibold">Moving to
              <select name="toState" required class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3 text-slate-950">
                <option value="" selected disabled>Choose a state</option>
                {Object.entries(stateData.states).sort(([, a], [, b]) => a.name.localeCompare(b.name)).map(([code, state]) => <option value={code}>{state.name}</option>)}
              </select>
            </label>
            <label class="block text-sm font-semibold">Home size
              <select name="size" class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3 text-slate-950">
                <option value="1">Studio / 1 room</option><option value="1.35">2–3 rooms</option><option value="1.8">4–5 rooms</option><option value="2.4">6+ rooms</option>
              </select>
            </label>
            <label class="block text-sm font-semibold">Move type
              <select name="type" class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3 text-slate-950">
                <option value="0.65">DIY</option><option value="1" selected>Rental truck + labor</option><option value="1.65">Full-service movers</option>
              </select>
            </label>
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="submit" class="rounded-xl bg-slate-950 px-6 py-3 font-semibold text-white hover:bg-slate-800">Build my budget →</button>
            <a href="/guides/relocation-budget/" class="text-sm font-semibold text-sky-700 underline">Read the budget guide</a>
          </div>
          <p class="mt-3 text-xs leading-5 text-slate-500">Your choices carry into the calculator. Add the costs you know, employer support and the cash you want ready. No email or quote request.</p>
        </form>
        <p class="mt-4 text-sm text-slate-400">Planning estimate, not a provider quote. Replace assumptions with written quotes for your addresses and inventory.</p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-300">Moving for a job? <a class="font-semibold text-white underline underline-offset-4" href="/calculator/">Compare your estimated costs with an employer lump sum and expenses paid directly</a>, then read our <a class="font-semibold text-white underline underline-offset-4" href="/guides/employer-relocation-package/">employer relocation package guide</a>. The calculator does not calculate taxes.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-700">How it works</p>
      <h2 class="mt-2 text-3xl font-bold">{HOME_ANSWER_HEADING}</h2>
      <p class="mt-4 leading-7 text-slate-600">{HOME_ANSWER_LEAD} {HOME_ANSWER_MOVE} {HOME_ANSWER_AROUND}</p>
      <p class="mt-3 leading-7 text-slate-600">{HOME_ANSWER_LIMITS}</p>
      <p class="mt-4 leading-7 text-slate-600"><a class="font-semibold text-sky-700 underline" href={HOME_ANSWER_LINKS.calculator.href}>{HOME_ANSWER_LINKS.calculator.label}</a> · <a class="font-semibold text-sky-700 underline" href={HOME_ANSWER_LINKS.employer.href}>{HOME_ANSWER_LINKS.employer.label}</a></p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {[
        ["01","Distance","Longer moves generally increase transport and travel costs."],
        ["02","Home size","More rooms usually mean more volume, labor, and packing."],
        ["03","Move type","Compare DIY, rental-truck, and full-service planning scenarios."]
      ].map(([n,t,d]) => <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><span class="text-sm font-bold text-sky-700">{n}</span><h3 class="mt-4 text-xl font-bold">{t}</h3><p class="mt-2 leading-7 text-slate-600">{d}</p></article>)}
    </div>
  </section>


  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-700">Route guides</p>
      <h2 class="mt-2 text-3xl font-bold">Planning a specific route?</h2>
      <p class="mt-4 leading-7 text-slate-600">Each route guide shows a planning distance, a published truck-rental benchmark and scenario totals by home size and move type.</p>
    </div>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="text-lg font-bold">City to city</h3>
        <ul class="mt-3 space-y-2">
          {featuredCityRoutes.map(route => <li><a class="text-sky-700 underline" href={`/moving-cost/cities/${route.slug}/`}>{cities[route.from].name} ↔ {cities[route.to].name}</a></li>)}
        </ul>
        <p class="mt-4"><a href="/moving-cost/cities/" class="font-semibold text-sky-700 underline">All city routes →</a></p>
      </div>
      <div>
        <h3 class="text-lg font-bold">State to state</h3>
        <ul class="mt-3 space-y-2">
          {featuredStateRoutes.map(route => <li><a class="text-sky-700 underline" href={`/moving-cost/${route.slug}/`}>{stateData.states[route.from].name} → {stateData.states[route.to].name}</a></li>)}
        </ul>
        <p class="mt-4"><a href="/moving-cost/" class="font-semibold text-sky-700 underline">All state routes →</a></p>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="grid gap-8 md:grid-cols-3">
        <a href="/guides/moving-cost/" class="rounded-2xl border border-slate-200 p-6 hover:border-slate-300"><p class="text-sm font-semibold text-sky-700">Guide</p><h2 class="mt-2 text-xl font-bold">What affects moving costs?</h2><p class="mt-2 leading-7 text-slate-600">Understand the main variables before collecting quotes.</p></a>
        <a href="/guides/relocation-budget/" class="rounded-2xl border border-slate-200 p-6 hover:border-slate-300"><p class="text-sm font-semibold text-sky-700">Guide</p><h2 class="mt-2 text-xl font-bold">Build a relocation budget</h2><p class="mt-2 leading-7 text-slate-600">Separate moving expenses from the costs around the move.</p></a>
        <a href="/guides/diy-vs-movers/" class="rounded-2xl border border-slate-200 p-6 hover:border-slate-300"><p class="text-sm font-semibold text-sky-700">Guide</p><h2 class="mt-2 text-xl font-bold">DIY vs. movers</h2><p class="mt-2 leading-7 text-slate-600">Compare planning considerations before choosing a move type.</p></a>
        <a href="/guides/reading-a-moving-quote/" class="rounded-2xl border border-slate-200 p-6 hover:border-slate-300"><p class="text-sm font-semibold text-sky-700">Guide</p><h2 class="mt-2 text-xl font-bold">Reading a moving quote</h2><p class="mt-2 leading-7 text-slate-600">Binding vs non-binding estimates, and what to ask before you sign.</p></a>
      </div>
    </div>
  </section>
</Layout>
