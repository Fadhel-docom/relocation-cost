---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Moving Cost Calculator — Relocation Cost">
  <section class="mx-auto max-w-5xl px-5 py-14">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-600">Free estimator</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">Moving cost calculator</h1>
      <p class="mt-4 text-slate-600">Enter three details to create a simple planning estimate.</p>
    </div>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
      <form id="calculator" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <label class="block text-sm font-semibold">Distance <span class="font-normal text-slate-500">(km)</span>
          <input id="distance" type="number" min="1" value="500" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-sky-500" />
        </label>
        <label class="mt-5 block text-sm font-semibold">Home size
          <select id="size" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3">
            <option value="1">Studio / 1 room</option><option value="1.35">2–3 rooms</option><option value="1.8">4–5 rooms</option><option value="2.4">6+ rooms</option>
          </select>
        </label>
        <label class="mt-5 block text-sm font-semibold">Move type
          <select id="type" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3">
            <option value="0.65">DIY</option><option value="1">Rental truck + labor</option><option value="1.65">Full-service movers</option>
          </select>
        </label>
        <button class="mt-7 w-full rounded-xl bg-slate-950 px-5 py-3 font-semibold text-white hover:bg-slate-800" type="submit">Calculate estimate</button>
      </form>
      <aside class="rounded-2xl bg-slate-950 p-7 text-white">
        <p class="text-sm text-slate-400">Planning estimate</p>
        <div id="result" class="mt-3 text-4xl font-bold">€1,050</div>
        <p class="mt-4 text-sm leading-6 text-slate-300">A broad planning range based on the inputs above. Actual quotes vary by route, access, season, packing, and provider.</p>
        <div class="mt-7 border-t border-slate-800 pt-5 text-sm text-slate-400">Estimated range: <strong id="range" class="text-white">€840–€1,260</strong></div>
      </aside>
    </div>
  </section>
  <script>
    const form = document.querySelector("#calculator");
    const distance = document.querySelector("#distance");
    const size = document.querySelector("#size");
    const type = document.querySelector("#type");
    const result = document.querySelector("#result");
    const range = document.querySelector("#range");
    const money = n => new Intl.NumberFormat("en-US", {style:"currency", currency:"EUR", maximumFractionDigits:0}).format(n);
    const calculate = () => {
      const km = Math.max(1, Number(distance.value) || 1);
      const estimate = Math.max(350, 350 + km * 0.9 * Number(size.value) * Number(type.value));
      result.textContent = money(estimate);
      range.textContent = money(estimate * .8) + "–" + money(estimate * 1.2);
    };
    form?.addEventListener("submit", e => { e.preventDefault(); calculate(); });
    [distance,size,type].forEach(el => el?.addEventListener("change", calculate));
  </script>
</Layout>
