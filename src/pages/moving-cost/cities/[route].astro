---
import Layout from "../../../layouts/Layout.astro";
import stateData from "../../../../data/state-distances.json";
import cityData from "../../../../data/cities.json";
import cityRoutes from "../../../../data/city-routes.json";
import statePages from "../../../../data/route-pages.json";
import benchmarkData from "../../../../data/coefficients.json";
import { calculateBudget, getUhaulBenchmark } from "../../../lib/calculator.js";

const money = value => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
const money2 = value => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);
const sizeOptions = [
  { label: "Studio / 1 room", size: 1 },
  { label: "2–3 rooms", size: 1.35 },
  { label: "4–5 rooms", size: 1.8 },
  { label: "6+ rooms", size: 2.4 }
];
const typeOptions = [
  { label: "DIY", type: 0.65 },
  { label: "Rental truck + labor", type: 1 },
  { label: "Full-service movers", type: 1.65 }
];

export function getStaticPaths() {
  // Astro runs getStaticPaths in an isolated scope: everything used here is
  // defined inside this function (only imports are visible).
  const toRadians = degrees => degrees * Math.PI / 180;
  const distanceBetween = (a, b) => {
    const lat1 = toRadians(a.lat);
    const lat2 = toRadians(b.lat);
    const dLat = toRadians(b.lat - a.lat);
    const dLon = toRadians(b.lon - a.lon);
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) ** 2;
    return Math.round(3958.7613 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h)));
  };
  const bearingBetween = (a, b) => {
    const lat1 = toRadians(a.lat);
    const lat2 = toRadians(b.lat);
    const dLon = toRadians(b.lon - a.lon);
    const y = Math.sin(dLon) * Math.cos(lat2);
    const x = Math.cos(lat1) * Math.sin(lat2) - Math.sin(lat1) * Math.cos(lat2) * Math.cos(dLon);
    return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
  };
  const compassName = degrees =>
    ["north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west"][Math.round(degrees / 45) % 8];
  const referenceTotal = distance => calculateBudget({ distance, size: 1.35, type: 1 }).total;

  const routes = cityRoutes.routes;
  const cities = cityData.cities;
  const describe = item => ({
    slug: item.slug,
    label: `${cities[item.from].name} → ${cities[item.to].name}`
  });
  const allDistances = routes.map(item => distanceBetween(cities[item.from], cities[item.to]));
  const sortedTotals = allDistances.map(referenceTotal).sort((a, b) => a - b);
  const mid = Math.floor(sortedTotals.length / 2);
  const medianTotal = sortedTotals.length % 2 ? sortedTotals[mid] : (sortedTotals[mid - 1] + sortedTotals[mid]) / 2;

  return routes.map(route => {
    const from = cities[route.from];
    const to = cities[route.to];
    const distance = distanceBetween(from, to);
    const touching = routes.filter(item =>
      item.slug !== route.slug &&
      (item.from === route.from || item.to === route.from || item.from === route.to || item.to === route.to)
    );
    // State-level guide for the same pair of states, in either direction.
    const stateRoute = statePages.routes.find(item =>
      (item.from === from.state && item.to === to.state) || (item.from === to.state && item.to === from.state)
    ) ?? null;
    return {
      params: { route: route.slug },
      props: {
        route,
        from,
        to,
        distance,
        direction: compassName(bearingBetween(from, to)),
        backDirection: compassName(bearingBetween(to, from)),
        shorterCount: allDistances.filter(value => value < distance).length,
        longerCount: allDistances.filter(value => value > distance).length,
        routeCount: routes.length,
        referenceRouteTotal: referenceTotal(distance),
        medianTotal,
        stateRoute: stateRoute ? { slug: stateRoute.slug, label: `${stateData.states[stateRoute.from].name} → ${stateData.states[stateRoute.to].name}` } : null,
        touching: touching.map(describe)
      }
    };
  });
}

const { route, from, to, distance, direction, backDirection, shorterCount, longerCount, routeCount, referenceRouteTotal, medianTotal, stateRoute, touching } = Astro.props;
const fromState = stateData.states[from.state].name;
const toState = stateData.states[to.state].name;
const sameState = from.state === to.state;
const benchmark = getUhaulBenchmark(distance);
const miles = distance.toLocaleString("en-US");

const grid = sizeOptions.map(size => ({
  ...size,
  cells: typeOptions.map(option => {
    const result = calculateBudget({ distance, size: size.size, type: option.type });
    return { ...option, total: result.total, low: result.rangeLow, high: result.rangeHigh };
  })
}));
const refRow = grid[1];
const calculatorUrl = `/calculator/?fromState=${from.state}&toState=${to.state}&distance=${distance}`;

const bands = benchmarkData.benchmarks.uhaul_one_way_average_by_distance;
const bandIndex = bands.findIndex(band => band.max_miles === null || distance <= band.max_miles);
const bandStart = bandIndex === 0 ? 1 : bands[bandIndex - 1].max_miles + 1;
const bandEnd = bands[bandIndex].max_miles;
const bandText = bandEnd === null
  ? `${bandStart.toLocaleString("en-US")} miles or more`
  : `${bandStart.toLocaleString("en-US")} to ${bandEnd.toLocaleString("en-US")} miles`;
const nextBand = bandEnd === null ? null : bands[bandIndex + 1];
const bandHeadroom = bandEnd === null ? null : bandEnd - distance;
const medianGapPercent = Math.round((referenceRouteTotal - medianTotal) / medianTotal * 100);
const medianText = Math.abs(medianGapPercent) < 3
  ? `close to the median planning total of ${money(medianTotal)} across the ${routeCount} city guides on this site`
  : `about ${Math.abs(medianGapPercent)}% ${medianGapPercent > 0 ? "above" : "below"} the median planning total of ${money(medianTotal)} across the ${routeCount} city guides on this site`;
const perMile = refRow.cells.map(cell => ({ label: cell.label, value: cell.total / distance }));

const title = `Moving from ${from.name} to ${to.name}: Cost Planning Guide`;
const faqs = [
  {
    q: `How far is it from ${from.name} to ${to.name}?`,
    a: `This page uses a planning distance of about ${miles} miles, measured in a straight line between the two city centers. Road mileage between your actual addresses will be longer.`
  },
  {
    q: `How much could a ${refRow.label} move from ${from.name} to ${to.name} cost?`,
    a: `In this calculator a ${refRow.label} move comes out at about ${refRow.cells.map(c => `${money(c.total)} for ${c.label.toLowerCase()}`).join(", ")}, before travel, housing or setup costs. These are planning estimates, not quotes.`
  },
  {
    q: `What does a one-way truck rental cost on average for about ${miles} miles?`,
    a: `U-Haul's published one-way average for the ${bandText} band is ${money(benchmark)} (${benchmarkData.sources.uhaul.data_period} data). It is a band average, not a quote for this route, because U-Haul states that prices depend on origin, destination, truck size, move date and inventory.`
  },
  {
    q: `Is moving from ${to.name} to ${from.name} priced the same way?`,
    a: `The planning distance is the same in both directions, so the planning totals match. Real one-way prices can still differ by direction because rental prices depend on origin, destination, truck size, move date and inventory.`
  },
  {
    q: `Why can a real quote be different from this estimate?`,
    a: `Real prices depend on your pickup and delivery addresses, truck size and availability, move date, shipment volume, labor scope, access conditions such as stairs and parking, and special items. Request written quotes based on your actual inventory before you decide.`
  }
];

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(item => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } }))
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Route costs", item: new URL("/moving-cost/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: "City routes", item: new URL("/moving-cost/cities/", Astro.site).href },
    { "@type": "ListItem", position: 4, name: `${from.name} to ${to.name}`, item: pageUrl }
  ]
};
---
<Layout
  title={title}
  description={`Plan a move from ${from.name}, ${from.state} to ${to.name}, ${to.state}: about ${miles} miles, a published truck-rental average, and DIY, truck and full-service planning totals by home size.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="mx-auto max-w-5xl px-5 py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a> <span aria-hidden="true">/</span>
      <a href="/moving-cost/" class="hover:text-slate-900">Route costs</a> <span aria-hidden="true">/</span>
      <a href="/moving-cost/cities/" class="hover:text-slate-900">City routes</a> <span aria-hidden="true">/</span>
      <span class="text-slate-700">{from.name} to {to.name}</span>
    </nav>
    <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-sky-600">City route planning guide</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">Moving from {from.name} to {to.name}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
      A planning starting point for a move from {from.name}, {from.state} to {to.name}, {to.state}. The distance is a city-center straight line, not road mileage, and the dollar figures are illustrative planning outputs rather than quotes. The same numbers apply if you are moving the other way.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm text-slate-500">Planning distance</p>
        <p class="mt-2 text-3xl font-bold">{miles} mi</p>
        <p class="mt-2 text-xs leading-5 text-slate-500">Great-circle distance between city centers.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm text-slate-500">Published truck-rental average</p>
        <p class="mt-2 text-3xl font-bold">{money(benchmark)}</p>
        <p class="mt-2 text-xs leading-5 text-slate-500">U-Haul one-way average for {bandText}; not a route quote.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm text-slate-500">Next step</p>
        <a href={calculatorUrl} data-route-cta="top" data-route={`city-${route.slug}`} class="mt-2 inline-block text-lg font-bold text-sky-700 underline">Open this route in the calculator →</a>
        <p class="mt-2 text-xs leading-5 text-slate-500">Adjust distance, home size, move type, and known extra costs.</p>
      </div>
    </div>

    <section class="mt-12" aria-labelledby="scenarios-heading">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-600">Illustrative scenarios</p>
      <h2 id="scenarios-heading" class="mt-2 text-3xl font-bold">Planning totals by home size and move type</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Each total starts from at least the published average one-way truck-rental price for this distance band and includes the calculator's 10% contingency. They are not quotes or predictions of what a mover will charge.</p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full min-w-[34rem] text-left text-sm">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold">Home size</th>
              {typeOptions.map(option => (<th scope="col" class="px-5 py-3 font-semibold">{option.label}</th>))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {grid.map(row => (
              <tr>
                <th scope="row" class="px-5 py-4 font-semibold">{row.label}</th>
                {row.cells.map(cell => (
                  <td class="px-5 py-4">
                    <span class="block text-lg font-bold">{money(cell.total)}</span>
                    <span class="block text-xs text-slate-500">{money(cell.low)}–{money(cell.high)}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="glance-heading">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-600">Route at a glance</p>
      <h2 id="glance-heading" class="mt-2 text-3xl font-bold">How {from.name} to {to.name} compares</h2>
      <dl class="mt-6 grid gap-5 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <dt class="font-bold">Direction and length</dt>
          <dd class="mt-2 leading-7 text-slate-600">Moving from {from.name} to {to.name} heads {direction}; the return trip heads {backDirection}. At about {miles} miles it is longer than {shorterCount} and shorter than {longerCount} of the other city guides on this site.</dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <dt class="font-bold">Where it sits on the price scale</dt>
          <dd class="mt-2 leading-7 text-slate-600">For a {refRow.label} home with a rental truck plus labor, the planning total of {money(referenceRouteTotal)} is {medianText}.</dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <dt class="font-bold">Mileage band sensitivity</dt>
          <dd class="mt-2 leading-7 text-slate-600">
            {nextBand
              ? `U-Haul's published average steps up from ${money(benchmark)} to ${money(nextBand.average_usd)} once a move passes ${bandEnd.toLocaleString("en-US")} miles. This route is ${bandHeadroom.toLocaleString("en-US")} miles below that point, and road mileage is longer than a straight line, so check which band your real addresses fall into.`
              : `This route is in the longest published band (${bandText}), so there is no higher band for the U-Haul average to step up to.`}
          </dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <dt class="font-bold">Cost per mile in this model</dt>
          <dd class="mt-2 leading-7 text-slate-600">For a {refRow.label} home the planning totals work out to {perMile.map(item => `${money2(item.value)} per mile for ${item.label.toLowerCase()}`).join(", ")}. Per-mile figures vary by route because the model starts from a fixed base cost and the published average steps up by distance band.</dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:col-span-2">
          <dt class="font-bold">{sameState ? `A move within ${fromState}` : `${fromState} and ${toState}`}</dt>
          <dd class="mt-2 leading-7 text-slate-600">
            {sameState
              ? `Both cities are in ${fromState}, so this is an in-state move. The calculator treats every move the same way: it uses distance, home size and move type, and does not model state-specific rules, fees or taxes.`
              : `This is an interstate move from ${fromState} to ${toState}. The calculator does not model state-specific rules, fees, taxes or cost-of-living differences; it uses distance, home size and move type only.`}
            {stateRoute && (<> For a state-level view, see the <a href={`/moving-cost/${stateRoute.slug}/`} class="font-semibold text-sky-700 underline">{stateRoute.label} route guide</a>.</>)}
          </dd>
        </div>
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-bold">Frequently asked questions</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
        {faqs.map(item => (
          <div class="p-5 sm:p-6">
            <h3 class="font-bold">{item.q}</h3>
            <p class="mt-2 leading-7 text-slate-600">{item.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <h2 class="text-2xl font-bold">What can change the real price?</h2>
      <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
        <li>Actual pickup and delivery addresses can differ substantially from city-center distance.</li>
        <li>Truck size, inventory, reservation date, season, and route availability affect rental pricing.</li>
        <li>Professional moving quotes depend on shipment volume, labor scope, access conditions, packing, and special items.</li>
        <li>Travel, temporary housing, deposits, setup costs, and packing supplies can materially change the full relocation budget.</li>
      </ul>
    </section>

    {touching.length > 0 && (
      <section class="mt-12" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-2xl font-bold">More city route guides</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {touching.map(item => (
            <li><a href={`/moving-cost/cities/${item.slug}/`} class="block rounded-xl border border-slate-200 bg-white px-5 py-4 font-semibold text-slate-900 hover:border-sky-300">{item.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-7 text-amber-950">
      <strong>Source and methodology note:</strong> the U-Haul mileage-band average is used only as a minimum base for the move cost, because a published band average does not establish a universal route price. The labor and service premium for each move type is an explicit planning assumption, and the city-center distance is an approximation. Replace all of these with route-specific information as soon as you have it. Read the full <a href="/methodology/" class="font-semibold underline">methodology and sources</a>.
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={calculatorUrl} data-route-cta="bottom" data-route={`city-${route.slug}`} class="rounded-xl bg-slate-950 px-6 py-3 font-semibold text-white">Calculate this route</a>
      <a href="/moving-cost/cities/" class="rounded-xl border border-slate-300 px-6 py-3 font-semibold text-slate-900">Browse city route guides</a>
    </div>
  </article>
</Layout>

<script>
  import { track } from "@vercel/analytics";
  document.querySelectorAll("[data-route-cta]").forEach(link => {
    link.addEventListener("click", () => {
      track("route_cta_clicked", { route: link.dataset.route ?? "", position: link.dataset.routeCta ?? "" });
    });
  });
</script>
