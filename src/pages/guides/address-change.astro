---
import Layout from "../../layouts/Layout.astro";
import GuideSchema from "../../components/GuideSchema.astro";
import GuideNext from "../../components/GuideNext.astro";
import { CHECKED_ON, DESCRIPTION, MAIL_FACTS, MAX_AGE_DAYS, NOT_STATED, SOURCES, STEPS, TIPS, TITLE, sourceNumber } from "../../lib/address-change.js";

const path = "/guides/address-change/";
const date = iso => {
  if (typeof iso !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return "an unknown date";
  const [year, month, day] = iso.split("-").map(Number);
  return new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(Date.UTC(year, month - 1, day)));
};
const cites = ids => ids.map((id, index) => ({ id, index }));
---
<Layout title={`${TITLE} — Relocation Cost`} description={DESCRIPTION}>
  <article class="mx-auto max-w-3xl px-5 py-14">
    <GuideSchema title={TITLE} description={DESCRIPTION} path={path} />
    <p class="text-sm font-semibold uppercase tracking-widest text-sky-700">Guide</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Who to tell when you move</h1>
    <p class="mt-5 text-lg leading-8 text-slate-600">A move changes where your mail, tax letters and records go. This guide lists the offices the official USAGov moving page tells you to update, and what the Postal Service says about when to file and how long mail is forwarded, with the source for every point.</p>

    <p id="staleNotice" hidden data-checked={CHECKED_ON ?? ""} data-max-days={MAX_AGE_DAYS} class="mt-8 rounded-2xl border border-amber-500 bg-white p-4 text-sm font-semibold leading-6 text-slate-900" role="status">The sources below were last verified more than {MAX_AGE_DAYS} days ago, or its check date is missing. The details may have changed. Confirm them on the official pages before you rely on them.</p>
    <script is:inline>
      (function () {
        var notice = document.getElementById("staleNotice");
        if (!notice) return;
        var parts = (notice.getAttribute("data-checked") || "").split("-").map(Number);
        var limit = Number(notice.getAttribute("data-max-days"));
        var checked = Date.UTC(parts[0], parts[1] - 1, parts[2]);
        var now = new Date();
        var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        var age = Math.round((today - checked) / 86400000);
        // Anything that cannot be trusted (bad date, future date, too old) shows the warning.
        if (!isFinite(age) || age < 0 || age > limit) notice.hidden = false;
      })();
    </script>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 text-sm leading-6 text-slate-700">
      <p><strong>Read this first.</strong> This is a summary of two official pages, last read by a person on {date(CHECKED_ON)}. It is not legal advice, it gives no prices, and the moving cost estimate does not use it. The offices' own pages decide what applies to you.</p>
    </div>

    <h2 class="mt-10 text-2xl font-bold">The offices on the official list</h2>
    <p class="mt-4 leading-7 text-slate-700">In the order the USAGov page gives them:</p>
    <ol class="mt-4 list-decimal space-y-4 pl-6 leading-7 text-slate-700">
      {STEPS.map(step => (<li><strong>{step.who}.</strong> {step.what}<sup class="ml-1">{cites(step.sources).map(({ id, index }) => (<>{index > 0 ? ", " : ""}<a class="text-sky-700 underline" href={`#src-${id}`}>{sourceNumber(id)}</a></>))}</sup></li>))}
    </ol>

    <h2 class="mt-10 text-2xl font-bold">Mail forwarding: what the Postal Service says</h2>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {MAIL_FACTS.map(fact => (<li>{fact.text}<sup class="ml-1">{cites(fact.sources).map(({ id, index }) => (<>{index > 0 ? ", " : ""}<a class="text-sky-700 underline" href={`#src-${id}`}>{sourceNumber(id)}</a></>))}</sup></li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">What the sources do not say</h2>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {NOT_STATED.map(line => (<li>{line}</li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">Practical steps</h2>
    <p class="mt-4 leading-7 text-slate-700">These are suggestions of ours, not statements from the sources.</p>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {TIPS.map(tip => (<li>{tip}</li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">Where the other tools fit</h2>
    <p class="mt-4 leading-7 text-slate-700">Put these tasks on dates with the <a class="font-semibold text-sky-700 underline" href="/checklist/">moving checklist</a>, and see what a move may cost in the <a class="font-semibold text-sky-700 underline" href="/calculator/">calculator</a>. Track what you actually spend in the <a class="font-semibold text-sky-700 underline" href="/budget-tracker/">budget tracker</a>.</p>

    <h2 class="mt-10 text-2xl font-bold">Sources</h2>
    <p class="mt-4 text-sm leading-6 text-slate-600">Each source shows when a person last read it. If a page was changed after that date, the newer text governs.</p>
    <ol class="mt-4 list-decimal space-y-3 pl-6 text-sm leading-6 text-slate-700">
      {SOURCES.map(source => (
        <li id={`src-${source.id}`}>
          <a class="font-semibold text-sky-700 underline" href={source.url} rel="noopener">{source.label}</a>
          {source.pageUpdated && <span class="text-slate-600"> (page updated {date(source.pageUpdated)})</span>}
          <span class="block text-slate-600">Read by a person; last verified {source.verified ? date(source.verified) : "unknown"}.</span>
        </li>
      ))}
    </ol>
    <GuideNext current={path} />
  </article>
</Layout>
