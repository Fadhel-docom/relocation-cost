---
import Layout from "../../layouts/Layout.astro";
import GuideSchema from "../../components/GuideSchema.astro";
import GuideNext from "../../components/GuideNext.astro";
import { CHECKED_ON, CONTACTS, DESCRIPTION, MAX_AGE_DAYS, NOT_STATED, QUESTIONS, RULE_GROUPS, SOURCES, TITLE, sourceNumber } from "../../lib/mover-checks.js";

const path = "/guides/checking-a-mover/";
const date = iso => {
  if (typeof iso !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return "an unknown date";
  const [year, month, day] = iso.split("-").map(Number);
  return new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(Date.UTC(year, month - 1, day)));
};
const cites = ids => ids.map((id, index) => ({ id, index }));
---
<Layout title={`${TITLE} — Relocation Cost`} description={DESCRIPTION}>
  <article class="mx-auto max-w-3xl px-5 py-14">
    <GuideSchema title={TITLE} description={DESCRIPTION} path={path} />
    <p class="text-sm font-semibold uppercase tracking-widest text-sky-700">Guide</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">How to check a moving company</h1>
    <p class="mt-5 text-lg leading-8 text-slate-600">A low price is not the only thing to compare. Before you pay a deposit, spend ten minutes confirming that the company is registered, that the paperwork is complete, and that you know where to complain if something goes wrong. This guide gathers what FMCSA and the FTC say, in plain words, with a source for every point.</p>

    <p id="staleNotice" hidden data-checked={CHECKED_ON ?? ""} data-max-days={MAX_AGE_DAYS} class="mt-8 rounded-2xl border border-amber-500 bg-white p-4 text-sm font-semibold leading-6 text-slate-900" role="status">At least one source below was last verified more than {MAX_AGE_DAYS} days ago, or its check date is missing. The advice may have changed. Confirm each point on the official pages in the sources list before you rely on it.</p>
    <script is:inline>
      (function () {
        var notice = document.getElementById("staleNotice");
        if (!notice) return;
        var parts = (notice.getAttribute("data-checked") || "").split("-").map(Number);
        var limit = Number(notice.getAttribute("data-max-days"));
        var checked = Date.UTC(parts[0], parts[1] - 1, parts[2]);
        var now = new Date();
        var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        var age = Math.round((today - checked) / 86400000);
        // Anything that cannot be trusted (bad date, future date, too old) shows the warning.
        if (!isFinite(age) || age < 0 || age > limit) notice.hidden = false;
      })();
    </script>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 text-sm leading-6 text-slate-700">
      <p><strong>Read this first.</strong> This is a summary of public guidance, last read by a person on {date(CHECKED_ON)}. It is not legal advice, it does not say that any company is dishonest, and it can go out of date, so rely on the official pages in the sources list. Most of the federal points apply to moves between states; for a move inside one state, ask your state's consumer protection office which rules apply. Renting a truck and moving yourself is a different arrangement: these checks are about hiring a mover or a broker.</p>
    </div>

    {RULE_GROUPS.map(group => (
      <section aria-labelledby={`h-${group.id}`}>
        <h2 id={`h-${group.id}`} class="mt-10 text-2xl font-bold">{group.title}</h2>
        <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
          {group.rules.map(rule => (
            <li>{rule.text}<sup class="ml-1">{cites(rule.sources).map(({ id, index }) => (<>{index > 0 ? ", " : ""}<a class="text-sky-700 underline" href={`#src-${id}`}>{sourceNumber(id)}</a></>))}</sup></li>
          ))}
        </ul>
      </section>
    ))}

    <h2 class="mt-10 text-2xl font-bold">Where to look and who to call</h2>
    <p class="mt-4 leading-7 text-slate-700">These are the tools and contacts the sources name. Use the links from this page only after checking that the address is the official one.</p>
    <ul class="mt-4 space-y-3 leading-7 text-slate-700">
      {CONTACTS.map(contact => (
        <li><span class="block text-sm text-slate-600">{contact.label}<sup class="ml-1">{cites(contact.sources).map(({ id, index }) => (<>{index > 0 ? ", " : ""}<a class="text-sky-700 underline" href={`#src-${id}`}>{sourceNumber(id)}</a></>))}</sup></span><a class="font-semibold text-sky-700 underline" href={contact.url} rel="noopener">{contact.text}</a></li>
      ))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">What the pages do not say</h2>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {NOT_STATED.map(line => (<li>{line}</li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">Questions to ask before you pay</h2>
    <p class="mt-4 leading-7 text-slate-700">These are suggestions, not legal requirements. Keep the answers in writing.</p>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {QUESTIONS.map(question => (<li>{question}</li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">Where the calculator fits</h2>
    <p class="mt-4 leading-7 text-slate-700">The <a class="font-semibold text-sky-700 underline" href="/calculator/">calculator</a> gives a planning range, so you can tell when a quote is far from what to expect and ask why. For what binding and non-binding estimates mean once you hold a written quote, read <a class="font-semibold text-sky-700 underline" href="/guides/reading-a-moving-quote/">How to read a moving quote</a>. The <a class="font-semibold text-sky-700 underline" href="/checklist/">checklist</a> reminds you what paperwork to keep.</p>

    <h2 class="mt-10 text-2xl font-bold">Sources</h2>
    <p class="mt-4 text-sm leading-6 text-slate-600">Each source shows when a person last read it. If a page was updated after the date shown here, the newer text governs.</p>
    <ol class="mt-4 list-decimal space-y-3 pl-6 text-sm leading-6 text-slate-700">
      {SOURCES.map(source => (
        <li id={`src-${source.id}`}>
          <a class="font-semibold text-sky-700 underline" href={source.url} rel="noopener">{source.label}</a>
          {source.pageUpdated && <span class="text-slate-600"> (page updated {date(source.pageUpdated)})</span>}
          <span class="block text-slate-600">Read by a person; last verified {source.verified ? date(source.verified) : "unknown"}.</span>
        </li>
      ))}
    </ol>
    <GuideNext current={path} />
  </article>
</Layout>
