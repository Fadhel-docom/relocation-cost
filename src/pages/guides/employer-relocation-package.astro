---
import Layout from "../../layouts/Layout.astro";
import GuideSchema from "../../components/GuideSchema.astro";
import GuideNext from "../../components/GuideNext.astro";
import { CHECKED_ON, DESCRIPTION, FACTS, LEAD, MAX_AGE_DAYS, NOT_STATED, QUESTIONS, SOURCES, TITLE, sourceNumber } from "../../lib/employer-package.js";

const path = "/guides/employer-relocation-package/";
const date = iso => {
  if (typeof iso !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return "an unknown date";
  const [year, month, day] = iso.split("-").map(Number);
  return new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(Date.UTC(year, month - 1, day)));
};
const cites = ids => ids.map((id, index) => ({ id, index }));
---
<Layout title={`${TITLE} — Relocation Cost`} description={DESCRIPTION}>
  <article class="mx-auto max-w-3xl px-5 py-14">
    <GuideSchema title={TITLE} description={DESCRIPTION} path={path} />
    <p class="text-sm font-semibold uppercase tracking-widest text-sky-700">Guide</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Employer relocation package</h1>
    <p class="mt-5 text-lg leading-8 text-slate-600">{LEAD} This guide shows what two IRS pages say about employer moving reimbursements and the moving expense deduction, and lists questions to ask before you rely on a package.</p>

    <p id="staleNotice" hidden data-checked={CHECKED_ON ?? ""} data-max-days={MAX_AGE_DAYS} class="mt-8 rounded-2xl border border-amber-500 bg-white p-4 text-sm font-semibold leading-6 text-slate-900" role="status">The IRS pages below were last verified more than {MAX_AGE_DAYS} days ago, or its check date is missing. The details may have changed. Confirm them on the official pages before you rely on them.</p>
    <script is:inline>
      (function () {
        var notice = document.getElementById("staleNotice");
        if (!notice) return;
        var parts = (notice.getAttribute("data-checked") || "").split("-").map(Number);
        var limit = Number(notice.getAttribute("data-max-days"));
        var checked = Date.UTC(parts[0], parts[1] - 1, parts[2]);
        var now = new Date();
        var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        var age = Math.round((today - checked) / 86400000);
        // Anything that cannot be trusted (bad date, future date, too old) shows the warning.
        if (!isFinite(age) || age < 0 || age > limit) notice.hidden = false;
      })();
    </script>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 text-sm leading-6 text-slate-700">
      <p><strong>Read this first.</strong> This is a summary of two IRS pages, last read by a person on {date(CHECKED_ON)}. It is not tax advice, it gives no amounts, and it does not calculate any tax. Your employer's payroll team or a tax professional can say how your own package is reported.</p>
    </div>

    <h2 class="mt-10 text-2xl font-bold">What the IRS pages say</h2>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {FACTS.map(fact => (<li>{fact.text}<sup class="ml-1">{cites(fact.sources).map(({ id, index }) => (<>{index > 0 ? ", " : ""}<a class="text-sky-700 underline" href={`#src-${id}`}>{sourceNumber(id)}</a></>))}</sup></li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">What the sources do not say</h2>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {NOT_STATED.map(line => (<li>{line}</li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">Questions to ask your employer</h2>
    <p class="mt-4 leading-7 text-slate-700">These are suggestions of ours, not statements from the sources.</p>
    <ul class="mt-4 list-disc space-y-3 pl-6 leading-7 text-slate-700">
      {QUESTIONS.map(question => (<li>{question}</li>))}
    </ul>

    <h2 class="mt-10 text-2xl font-bold">Where the calculator fits</h2>
    <p class="mt-4 leading-7 text-slate-700">The <a class="font-semibold text-sky-700 underline" href="/calculator/">calculator</a> has an optional employer package section: enter the lump sum and the costs the employer pays directly to see the gap between your estimate and what is covered. It does not calculate taxes, so enter amounts as you will actually receive or use them. Track real spending in the <a class="font-semibold text-sky-700 underline" href="/budget-tracker/">budget tracker</a>.</p>

    <h2 class="mt-10 text-2xl font-bold">Sources</h2>
    <p class="mt-4 text-sm leading-6 text-slate-600">Each source shows when a person last read it. If a page was changed after that date, the newer text governs.</p>
    <ol class="mt-4 list-decimal space-y-3 pl-6 text-sm leading-6 text-slate-700">
      {SOURCES.map(source => (
        <li id={`src-${source.id}`}>
          <a class="font-semibold text-sky-700 underline" href={source.url} rel="noopener">{source.label}</a>
          {source.pageUpdated && <span class="text-slate-600"> (page updated {date(source.pageUpdated)})</span>}
          <span class="block text-slate-600">Read by a person; last verified {source.verified ? date(source.verified) : "unknown"}.</span>
        </li>
      ))}
    </ol>
    <GuideNext current={path} />
  </article>
</Layout>
