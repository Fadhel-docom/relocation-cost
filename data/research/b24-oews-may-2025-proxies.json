  "methodology": {
    "source_of_original_estimates": "U.S. Bureau of Labor Statistics Occupational Employment and Wage Statistics (OEWS), May 2025 state and metropolitan/nonmetropolitan files.",
    "intermediary": "WageDex open-data pages and occupation/area pages; values are transcribed from its published tables that identify BLS OEWS May 2025 as the source.",
    "limitation": "This is not a direct BLS file extraction. Relative standard errors (RSEs) are not included in this intermediary dataset; rse is null and must not be treated as zero. BLS suppression/missingness is not inferred where a metro row is absent.",
    "scope": "OEWS covers wage-and-salary jobs across all industries, not only household-goods movers. SOC 53-3032 includes tractor-trailer drivers; SOC 53-3033 includes light/delivery truck drivers; SOC 53-7062 is broad manual freight/material movement.",
    "use": "Research cross-check and geographic sensitivity only. Do not add to production coefficients or claim residential-mover-specific wages.",
    "state_coverage": "19 states represented in the current route-page endpoint set; this is not a complete national state file.",
    "metro_coverage": "17 of the 18 city nodes currently in data/cities.json have a published SOC 53-7062 metro value captured here; Chicago is intentionally absent pending a verifiable occupation-specific metro row.",
    "annual_hourly_note": "Annual and hourly medians are transcribed independently from the published table; do not derive one from the other.",
    "attribution": "WageDex CC BY 4.0 compilation; underlying wage estimates are U.S. government BLS OEWS data."
